# ==============================================================================
# EduPredict AI - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named ".env" in the project root:
#       cp .env.example .env
# 2. Replace the placeholder values below with your actual configuration.
# 3. NEVER commit your ".env" file or expose your real API keys in code.
# ==============================================================================

# Your Google Gemini API key (get one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI backend URL used by the Streamlit frontend
BACKEND_URL=http://127.0.0.1:8000

